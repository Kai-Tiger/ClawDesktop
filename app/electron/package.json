{
  "name": "openclaw-electron-phase2",
  "productName": "Clawin Desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 file:dist/main/index.js file:dist/preload/index.js && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac:zip": "electron-builder --mac zip",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --config electron-builder-x64.yml",
    "dist:mac:x64:zip": "electron-builder --mac zip --x64 --config electron-builder-x64.yml",
    "mac": "rm -rf dist/renderer && npm run build && npm run dist:mac:zip",
    "mac:x64": "rm -rf dist/renderer && npm run build && npm run dist:mac:x64:zip",
    "dist:mac:dir": "electron-builder --mac dir"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "highlight.js": "^11.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.12",
    "wait-on": "^7.2.0"
  }
}
